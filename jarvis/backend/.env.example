# === ANTHROPIC ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === WEATHER ===
# Free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# === GOOGLE CALENDAR ===
# Create credentials at https://console.cloud.google.com
# OAuth 2.0 Client ID (Desktop app type)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/auth/callback

# === APP ===
PORT=3001
FRONTEND_URL=http://localhost:5173

# === JARVIS IDENTITY ===
# How JARVIS addresses you
USER_NAME=Sir
